{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aina",
  "mainBinaryName": "aina",
  "version": "1.0.2",
  "identifier": "id.ai.aina.desktop",
  "build": {
    "frontendDist": "../../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://api.openai.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../../extension": "extension", "../../native/wake/AinaWake.exe": "wake/AinaWake.exe" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "licenseFile": "installer/license.txt",
    "copyright": "© Faisal Mashuri",
    "publisher": "Faisal Mashuri",
    "shortDescription": "aina, teman yang paham layar",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Indonesian", "English"],
        "displayLanguageSelector": false,
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "aina"
      }
    }
  }
}
