<Rive version="1" kind="fragment">
    <!--
        Body component. Origin at the body's centre (originX/Y 0.5), so a host
        places it with x/y at the centre and squashes/stretches around it.
    -->
    <Artboard styleId="0:1095" isComponent="true" originX="0.5" originY="0.5" defaultStateMachineId="0:1090"
              x="0" y="600" width="280" height="280" name="Body" id="0:1000">
        <LayoutComponentStyle name="Artboard Style" id="0:1095"/>


        <StateMachine name="Body SM" id="0:1090">
            <StateMachineLayer name="Jelly" id="0:1091">
                <AnyState x="400" y="0"/>
                <ExitState x="560" y="0"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:1093"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:1094" id="0:1093"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- Specular highlights: soft pastel sheen + crisp glints, upper left. -->
        <Node name="Highlights" id="0:1010">
            <Shape x="-62" y="-64" rotation="-0.75" name="Glint Small" id="0:1011">
                <Ellipse width="10" height="5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="E6FFFFFF" name="Color"/></Fill>
            </Shape>
            <Shape x="-44" y="-80" rotation="-0.45" name="Glint Arc" id="0:1012">
                <PointsPath isClosed="false" name="Path">
                    <StraightVertex x="-16" y="8"/>
                    <CubicDetachedVertex x="12" y="-6" inRotation="2.9" inDistance="14" outRotation="0" outDistance="0"/>
                </PointsPath>
                <Stroke thickness="4" cap="round" name="Stroke">
                    <SolidColor colorValue="B3FFFFFF" name="Color"/>
                    <Feather strength="2" name="Feather"/>
                </Stroke>
            </Shape>
            <Shape x="-48" y="-58" rotation="-0.6" name="Sheen" id="0:1013">
                <Ellipse width="64" height="38" name="Path"/>
                <Fill fillRule="clockwise" name="Fill">
                    <SolidColor colorValue="CCFFFFFF" name="Color"/>
                    <Feather strength="14" name="Feather"/>
                </Fill>
            </Shape>
        </Node>

        <!-- Rim: glassy outline that sells the translucent material. -->
        <Shape name="Rim" id="0:1020">
            <PointsPath isClosed="true" name="Path" id="0:1021">
                <CubicMirroredVertex x="20" y="-122" rotation="0.08" distance="44" id="0:1061"/>
                <CubicMirroredVertex x="106" y="-28" rotation="1.3" distance="50" id="0:1062"/>
