                <Feather strength="4" inner="true" name="Feather"/>
            </Stroke>
            <Stroke thickness="1.2" name="Edge">
                <SolidColor colorValue="99B8C6EE" name="Color"/>
            </Stroke>
        </Shape>

        <!-- Watercolor washes, clipped to the body silhouette. -->
        <Node name="Washes" id="0:1030">
