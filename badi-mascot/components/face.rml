        <!-- Lipsync. Jaw sits inside Talk, so the pose layer and lipsync never key the same node. -->
        <LinearAnimation duration="1" name="Jaw Rest" id="0:3424">
            <KeyedObject objectId="0:1325">
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0"/>
